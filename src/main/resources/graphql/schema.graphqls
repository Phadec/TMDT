type User {
    id: ID!
    firstName: String!
    lastName: String!
    username: String!
    email: String!
    phoneNumber: String
    avatar: String
    role: String!
    enabled: Boolean!
    emailVerified: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Category {
    id: ID!
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean!
    productCount: Int
}

enum ProductCondition {
    NEW
    LIKE_NEW
    GOOD
    FAIR
    POOR
}

type Product {
    id: ID!
    title: String!
    description: String!
    price: Float!
    categoryId: String!
    condition: ProductCondition!
    images: [String!]!
    location: String!
    sellerUsername: String!
    negotiable: Boolean!
    status: String!
    createdAt: String!
    updatedAt: String!
    views: Int!
    favorites: Int!
    category: Category
    seller: User
    quantity: Int
    reviews: [Review!]
    reviewSummary: ReviewSummary
    isFavorited: Boolean
}

type CartItem {
    id: ID!
    username: String!
    product: Product!
    productId: String!
    quantity: Int!
    dateAdded: String!
}

type FavoriteProduct {
    id: ID!
    username: String!
    productId: String!
    product: Product
    dateAdded: String!
}

type CategoryOption {
    id: ID!
    name: String!
    level: Int!
    parentName: String
}

type CategoryProductCount {
    id: ID!
    count: Int!
}

enum OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
}

enum PaymentMethod {
    COD
    BANK_TRANSFER
    CREDIT_CARD
}

type OrderItem {
    id: ID
    product: Product!
    quantity: Int!
    price: Float!
}

type CustomerInfo {
    fullName: String!
    email: String!
    phone: String!
    address: String!
}

type Order {
    id: ID!
    orderNumber: String!
    username: String!
    customerInfo: CustomerInfo!
    items: [OrderItem!]!
    totalAmount: Float!
    status: OrderStatus!
    paymentMethod: PaymentMethod!
    notes: String
    createdAt: String!
    updatedAt: String
}

type Review {
    id: ID!
    productId: String!
    username: String!
    userFullName: String!
    userAvatar: String
    rating: Int!
    comment: String
    createdAt: String!
    updatedAt: String
    verified: Boolean!
    approved: Boolean!
    sellerReply: String
    sellerReplyAt: String
}

type ReviewSummary {
    averageRating: Float!
    totalReviews: Int!
    fiveStarCount: Int!
    fourStarCount: Int!
    threeStarCount: Int!
    twoStarCount: Int!
    oneStarCount: Int!
}

type Query {
    # User queries
    users: [User!]!
    user(id: ID!): User
    
    # Category queries
    categories: [Category!]!
    category(id: ID!): Category
    categoryBySlug(slug: String!): Category
    availableCategories: [CategoryOption!]!
    categoryProductCounts(excludeStatuses: [String!]): [CategoryProductCount!]!
    
    # Product queries
    products(page: Int!, size: Int!): [Product!]!
    product(id: ID!): Product
    productsByCategory(categoryId: ID!, page: Int!, size: Int!): [Product!]!
    productsBySeller(username: String!, page: Int!, size: Int!): [Product!]!
    sellerProducts(username: String!, status: String!): [Product!]!
    searchProducts(keyword: String!, page: Int!, size: Int!): [Product!]!

    # Favorite queries
    userFavorites: [FavoriteProduct!]!

    # Cart queries
    cartItems(username: String!, page: Int = 0, size: Int = 10): [CartItem!]!
    cartItemCount(username: String!): Int!

    # Order queries
    orders(username: String!): [Order!]!
    order(id: ID!): Order
    sellerOrders: [Order!]!
    sellerOrderDetail(id: ID!): Order

    # Review queries
    productReviews(productId: ID!, page: Int = 0, size: Int = 10): [Review!]!
    userReviews(username: String!): [Review!]!
    reviewSummary(productId: ID!): ReviewSummary!
    canReviewProduct(productId: ID!): Boolean!
}

type Mutation {
    # Product mutations
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
    toggleProductStatus(id: ID!, status: String!): Product!

    # Cart mutations
    addToCart(productId: ID!, quantity: Int = 1): CartItem
    updateCartItemQuantity(productId: ID!, quantity: Int!): CartItem
    removeFromCart(productId: ID!): Boolean!
    clearCart: Boolean!

    # Order mutations
    createOrder(input: OrderInput!): Order!
    updateOrderStatus(id: ID!, status: OrderStatus!): Order!
    cancelOrder(id: ID!): Order!

    # Review mutations
    createReview(input: ReviewInput!): Review!
    updateReview(id: ID!, input: ReviewUpdateInput!): Review!
    deleteReview(id: ID!): Boolean!
    respondToReview(id: ID!, response: String!): Review!

    # Product interaction mutations
    incrementProductViews(id: ID!): Product!
    toggleProductFavorite(id: ID!): Product!
}

input CategoryInput {
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean
}

input ProductInput {
    title: String!
    description: String!
    price: Float!
    categoryId: String!
    condition: ProductCondition!
    images: [String!]!
    location: String!
    negotiable: Boolean!
    quantity: Int = 1
}

input CartItemInput {
    productId: String!
    quantity: Int!
}

input CustomerInfoInput {
    fullName: String!
    email: String!
    phone: String!
    address: String!
}

input OrderItemInput {
    productId: ID!
    quantity: Int!
    price: Float!
}

input OrderInput {
    customerInfo: CustomerInfoInput!
    items: [OrderItemInput!]!
    totalAmount: Float!
    paymentMethod: PaymentMethod!
    notes: String
}

input ReviewInput {
    productId: ID!
    rating: Int!
    comment: String
}

input ReviewUpdateInput {
    rating: Int
    comment: String
}
