type User {
    id: ID!
    firstName: String
    lastName: String
    username: String!
    email: String!
    phoneNumber: String
    avatar: String
    role: String
    emailVerified: Boolean
    createdAt: String
    updatedAt: String
    totalSoldProducts: Int
}

type UserResponseDTO {
    id: ID!
    username: String!
    email: String!
    firstName: String
    lastName: String
    phoneNumber: String
    avatar: String
    role: String
    emailVerified: Boolean
    createdAt: String
    updatedAt: String
    totalSoldProducts: Int
}

type Category {
    id: ID!
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean!
    productCount: Int
}

enum ProductCondition {
    NEW
    LIKE_NEW
    GOOD
    FAIR
    POOR
}

type Product {
    id: ID!
    title: String!
    description: String
    price: Float!
    categoryId: String
    category: Category
    condition: String
    images: [String]
    location: String
    sellerUsername: String
    seller: User
    negotiable: Boolean
    status: String
    createdAt: String
    updatedAt: String
    views: Int
    favorites: Int
    quantity: Int
    soldQuantity: Int
    isFavorited: Boolean
    reviewSummary: ReviewSummary
}

type CartItem {
    id: ID!
    username: String!
    product: Product
    productId: ID!
    quantity: Int!
    dateAdded: String
}

type FavoriteProduct {
    id: ID!
    username: String!
    productId: String!
    product: Product
    dateAdded: String!
}

type CategoryOption {
    id: ID!
    name: String!
    level: Int!
    parentName: String
}

type CategoryProductCount {
    id: ID!
    count: Int!
}

enum OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
}

enum PaymentMethod {
    COD
    BANK_TRANSFER
    CREDIT_CARD
}

type OrderItem {
    id: ID
    product: Product!
    quantity: Int!
    price: Float!
}

type CustomerInfo {
    fullName: String!
    email: String!
    phone: String!
    address: String!
}

type Order {
    id: ID!
    orderNumber: String!
    username: String
    customerInfo: CustomerInfo!
    items: [OrderItem!]!
    totalAmount: Float!
    subtotal: Float       # Add this field for original price before discount
    discountAmount: Float # Add this field for discount amount
    promoCode: String     # Add this field for the promo code
    status: String!
    paymentMethod: String!
    notes: String
    createdAt: String
    updatedAt: String
}

type Review {
    id: ID!
    productId: String!
    username: String!
    userFullName: String!
    userAvatar: String
    rating: Int!
    comment: String
    createdAt: String!
    updatedAt: String
    verified: Boolean!
    approved: Boolean!
    sellerReply: String
    sellerReplyAt: String
}

type ReviewSummary {
    averageRating: Float!
    totalReviews: Int!
    fiveStarCount: Int!
    fourStarCount: Int!
    threeStarCount: Int!
    twoStarCount: Int!
    oneStarCount: Int!
}

type Chat {
    id: ID!
    participants: [User!]!
    lastMessage: Message
    unreadCount: Int
    product: Product
    productId: String
    createdAt: String!
    updatedAt: String
}

type Message {
    id: ID!
    chatId: String!
    senderId: String!
    sender: User
    content: String!
    imageUrl: String
    messageType: MessageType!
    read: Boolean!
    createdAt: String!
}

enum MessageType {
    TEXT
    IMAGE
    FILE
}

type Report {
    id: ID!
    reportType: String!        # USER or PRODUCT
    reportedItemId: String!
    reportedBy: String!
    reason: String!
    details: String
    status: String!            # PENDING, REVIEWED, RESOLVED, REJECTED
    createdAt: String!
    updatedAt: String
    reviewedBy: String
    resolution: String
    reportedUser: User         # If reportType is USER
    reportedProduct: Product   # If reportType is PRODUCT
    reporter: User
    reviewer: User
}

type PromoCode {
    id: ID!
    code: String!
    description: String
    discountAmount: Float
    discountPercent: Float
    minimumPurchase: Float
    validFrom: String
    validTo: String
    usageLimit: Int
    usageCount: Int
    isActive: Boolean
}

type PromoCodeValidation {
    valid: Boolean!
    code: String
    discount: Float
    description: String
    message: String
}

type Query {
    # User queries
    users: [User!]!
    user(id: ID!): User
    userByUsername(username: String!): User
    currentUser: User
    
    # Category queries
    categories: [Category!]!
    category(id: ID!): Category
    categoryBySlug(slug: String!): Category
    availableCategories: [CategoryOption!]!
    categoryProductCounts(excludeStatuses: [String!]): [CategoryProductCount!]!
    
    # Product queries
    products(page: Int!, size: Int!): [Product!]!
    product(id: ID!): Product
    productsByCategory(categoryId: ID!, page: Int!, size: Int!): [Product!]!
    productsBySeller(username: String!, page: Int!, size: Int!): [Product!]!
    sellerProducts(username: String!, status: String!): [Product!]!
    searchProducts(keyword: String!, page: Int!, size: Int!): [Product!]!

    # Favorite queries
    userFavorites: [FavoriteProduct!]!

    # Cart queries
    cartItems(page: Int!, size: Int!): [CartItem]
    cartItemCount: Int

    # Order queries
    orders(username: String!): [Order!]!
    order(id: ID!): Order
    sellerOrders: [Order!]!
    sellerOrderDetail(id: ID!): Order

    # Review queries
    productReviews(productId: ID!, page: Int = 0, size: Int = 10): [Review!]!
    userReviews(username: String!): [Review!]!
    reviewSummary(productId: ID!): ReviewSummary!
    canReviewProduct(productId: ID!): Boolean!

    # Chat queries
    userChats: [Chat!]!
    chatMessages(chatId: ID!, page: Int!, size: Int!): [Message!]!
    chat(id: ID!): Chat
    chatWithSeller(sellerId: ID!, productId: ID): Chat

    # Report queries
    pendingReports: [Report!]!
    userReports: [Report!]!
    itemReports(type: String!, itemId: ID!): [Report!]!
    pendingReportCount(type: String!, itemId: ID!): Int!

    # Total sold products query
    totalSoldProductsByUsername(username: String!): Int!

    # Promo code queries
    allPromoCodes: [PromoCode]
    validatePromoCode(code: String!, cartTotal: Float!): PromoCodeValidation
    activePromoCodes: [PromoCode]
}

type Mutation {
    # Product mutations
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
    toggleProductStatus(id: ID!, status: String!): Product!

    # Cart mutations
    addToCart(productId: ID!, quantity: Int = 1): CartItem
    updateCartItemQuantity(productId: ID!, quantity: Int!): CartItem
    removeFromCart(productId: ID!): Boolean!
    clearCart: Boolean!

    # Order mutations
    createOrder(input: OrderInput!): Order!
    updateOrderStatus(id: ID!, status: OrderStatus!): Order!
    cancelOrder(id: ID!): Order!

    # Review mutations
    createReview(input: ReviewInput!): Review!
    updateReview(id: ID!, input: ReviewUpdateInput!): Review!
    deleteReview(id: ID!): Boolean!
    respondToReview(id: ID!, response: String!): Review!

    # Product interaction mutations
    incrementProductViews(id: ID!): Product!
    toggleProductFavorite(id: ID!): Product!

    # Chat mutations
    sendMessage(chatId: ID!, content: String!, messageType: MessageType! = TEXT, imageUrl: String): Message!
    createChat(sellerId: ID!, productId: ID): Chat!
    markMessagesAsRead(chatId: ID!): Boolean!

    # Report mutations
    createReport(input: ReportInput!): Report!
    reviewReport(id: ID!, status: String!, resolution: String): Report!
    
    # Promo code mutations
    createPromoCode(input: PromoCodeInput!): PromoCode
    updatePromoCode(id: ID!, input: PromoCodeInput!): PromoCode
    deletePromoCode(id: ID!): Boolean
    applyPromoCode(code: String!, cartTotal: Float!): Float
    createSamplePromoCodes: Boolean

    # For file uploads, use REST endpoint /api/files/upload instead
    # No longer using the Upload scalar
}

input CategoryInput {
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean
}

input ProductInput {
    title: String!
    description: String!
    price: Float!
    categoryId: String!
    condition: ProductCondition!
    images: [String!]!
    location: String!
    negotiable: Boolean!
    quantity: Int = 1
}

input CartItemInput {
    productId: String!
    quantity: Int!
}

input CustomerInfoInput {
    fullName: String!
    email: String!
    phone: String!
    address: String!
}

input OrderItemInput {
    productId: ID!
    quantity: Int!
    price: Float!
}

input OrderInput {
    customerInfo: CustomerInfoInput!
    items: [OrderItemInput!]!
    totalAmount: Float!
    subtotal: Float       # Add this field for original price before discount
    discountAmount: Float # Add this field for discount amount
    promoCode: String     # Add this field for the promo code
    paymentMethod: String!
    notes: String
}

input ReviewInput {
    productId: ID!
    rating: Int!
    comment: String
}

input ReviewUpdateInput {
    rating: Int
    comment: String
}

input ReportInput {
    reportType: String!        # USER or PRODUCT
    reportedItemId: ID!
    reason: String!
    details: String
}

input PromoCodeInput {
    code: String!
    description: String
    discountAmount: Float
    discountPercent: Float
    minimumPurchase: Float
    validFrom: String
    validTo: String
    usageLimit: Int
    isActive: Boolean
}
