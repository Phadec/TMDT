type User {
    id: ID!
    firstName: String!
    lastName: String!
    username: String!
    email: String!
    phoneNumber: String
    avatar: String
    role: String!
    enabled: Boolean!
    emailVerified: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Category {
    id: ID!
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean!
}

enum ProductCondition {
    NEW
    LIKE_NEW
    GOOD
    FAIR
    POOR
}

type Product {
    id: ID!
    title: String!
    description: String!
    price: Float!
    categoryId: String!
    condition: ProductCondition!
    images: [String!]!
    location: String!
    sellerUsername: String!
    negotiable: Boolean!
    status: String!
    createdAt: String!
    updatedAt: String!
    views: Int!
    favorites: Int!
    category: Category
    seller: User
}

type Query {
    # User queries
    users: [User!]!
    user(id: ID!): User
    
    # Category queries
    categories: [Category!]!
    category(id: ID!): Category
    categoryBySlug(slug: String!): Category
    availableCategories: [CategoryOption!]!
    
    # Product queries
    products(page: Int!, size: Int!): [Product!]!
    product(id: ID!): Product
    productsByCategory(categoryId: ID!, page: Int!, size: Int!): [Product!]!
    productsBySeller(username: String!, page: Int!, size: Int!): [Product!]!
    sellerProducts(username: String!, status: String!): [Product!]!
    searchProducts(keyword: String!, page: Int!, size: Int!): [Product!]!
}

type CategoryOption {
    id: ID!
    name: String!
    level: Int!
    parentName: String
}

type Mutation {
    # Product mutations only
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
    toggleProductStatus(id: ID!, status: String!): Product!
}

input CategoryInput {
    name: String!
    slug: String!
    description: String
    parentId: String
    image: String
    level: Int!
    isActive: Boolean
}

input ProductInput {
    title: String!
    description: String!
    price: Float!
    categoryId: String!
    condition: ProductCondition!
    images: [String!]!
    location: String!
    negotiable: Boolean!
}
